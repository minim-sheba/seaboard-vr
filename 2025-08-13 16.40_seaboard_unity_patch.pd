#N canvas 0 0 903 834 12;
#X obj 50 50 notein;
#X obj 50 120 select 0;
#X obj 120 120 > 0;
#X obj 50 180 t b b;
#X obj 120 180 t b b;
#X obj 50 220 f;
#X obj 80 220 - 1;
#X obj 120 220 f;
#X obj 150 220 + 1;
#X obj 85 280 max 0;
#X obj 85 320 > 0;
#X obj 85 360 sendOSC;
#X msg 150 400 connect localhost 8000;
#X obj 85 440 send /seaboard/note_active;
#X text 200 50 MIDI note input from Seaboard;
#X text 200 120 Check if velocity = 0 (note off);
#X text 200 180 Trigger counter operations;
#X text 200 220 Counter: subtract 1 for note off;
#X text 247 241 Counter: add 1 for note on;
#X text 200 280 Ensure counter never goes below 0;
#X text 200 320 Convert counter to boolean (0 or 1);
#X text 200 360 Send OSC message;
#X text 324 400 Connect to Unity (localhost port 8000);
#X text 50 500 Instructions:;
#X text 50 520 1 Click the "connect localhost 8000" message to establish OSC connection;
#X text 51 560 2 Play notes on Seaboard - patch will send 1 when any key pressed\\\, 0 when all released;
#X text 50 609 3 In Unity\\\, receive OSC messages at address /seaboard/note_active;
#X connect 0 0 2 0;
#X connect 0 1 1 0;
