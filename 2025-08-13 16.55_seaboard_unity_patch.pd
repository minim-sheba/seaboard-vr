#N canvas 0 0 800 600 12;
#X obj 50 50 notein;
#X obj 50 120 select 0;
#X obj 120 120 > 0;
#X obj 50 180 t b b;
#X obj 120 180 t b b;
#X obj 50 220 f;
#X obj 80 220 - 1;
#X obj 120 220 f;
#X obj 150 220 + 1;
#X obj 85 280 max 0;
#X obj 85 320 > 0;
#X msg 85 360 send /seaboard/note_active \$1;
#X obj 85 400 packOSC;
#X obj 85 440 udpsend;
#X msg 200 440 connect localhost 8000;
#X obj 85 480 print OSC_sent;
#X text 250 50 MIDI note input from Seaboard;
#X text 250 120 Check if velocity = 0 (note off);
#X text 250 180 Trigger counter operations;
#X text 250 220 Counter: subtract 1 for note off;
#X text 300 220 Counter: add 1 for note on;
#X text 250 280 Ensure counter never goes below 0;
#X text 250 320 Convert counter to boolean (0 or 1);
#X text 250 360 Format OSC message;
#X text 250 400 Package as OSC bundle;
#X text 250 440 Send via UDP to Unity;
#X text 50 520 Instructions:;
#X text 50 540 1. Click "connect localhost 8000" to establish UDP connection;
#X text 50 560 2. Play notes on Seaboard - sends 1 when pressed\, 0 when released;
#X text 50 580 3. Check Pure Data console for "OSC_sent" confirmations;
#X text 50 600 4. In Unity\, receive OSC at address /seaboard/note_active;
