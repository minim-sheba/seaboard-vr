#N canvas 0 0 800 600 12;
#X declare -path mrpeach;
#X obj 50 50 notein;
#X obj 200 50 bendin;
#X obj 50 100 mtof;
#X obj 200 100 / 8192;
#X obj 200 150 * 2;
#X obj 50 150 +;
#X obj 50 200 osc~;
#X obj 50 250 *~;
#X obj 50 300 dac~;
#X obj 100 100 > 0;
#X obj 100 150 * 0.3;
#X text 350 50 Get MIDI note input;
#X text 350 70 Get pitch bend input;
#X text 350 100 Convert MIDI note to frequency;
#X text 350 120 Convert bend (-8192 to +8191) to multiplier;
#X text 350 140 Multiply by 2 for +/- 1 semitone range;
#X text 350 160 Add bend offset to base frequency;
#X text 350 200 Sine wave oscillator;
#X text 350 250 Amplitude control from velocity;
#X text 350 300 Audio output;
#X obj 250 200 + 1;
#X obj 250 250 *;
#X text 350 230 (bend + 1) * base_freq = final_freq;
#X text 50 400 Instructions:;
#X text 50 420 1. Play a note on the Seaboard;
#X text 50 440 2. Wiggle finger left/right for pitch bend;
#X text 50 460 3. This is monophonic - latest note takes priority;
#X text 50 480 4. Bend range is about +/- 1 semitone;
#X connect 0 0 3 0;
#X connect 0 1 7 0;
#X connect 1 0 4 0;
#X connect 3 0 6 0;
#X connect 4 0 5 0;
#X connect 5 0 11 0;
#X connect 6 0 12 0;
#X connect 7 0 8 0;
#X connect 8 0 9 1;
#X connect 9 0 10 0;
#X connect 10 0 10 1;
#X connect 11 0 12 1;
#X connect 12 0 7 0;