#N canvas 120 80 1280 840 10;
#X obj 40 20 cnv 15 440 60 empty empty mpe_poly_dual_zones 20 12 0 14 -228856 -1 0;
#X text 50 25 Two independent MPE zones running in parallel (Lower + Upper);
#X text 50 45 Route each zone to a different "engine" (synth/patch) in Pd;
#X obj 60 110 loadbang;
#X msg 60 140 zone lower;
#X msg 160 140 normalize 1;
#X msg 260 140 pbmode 0;
#X msg 340 140 bendrange 48;
#X obj 60 180 s ctlL;
#X obj 60 220 r ctlL;
#X obj 60 250 mpe_poly;
#X obj 60 290 route note off;
#X obj 60 320 s engineL_events;
#X obj 240 320 s engineL_offs;
#X obj 380 290 route pb timbre pressure state pb_global;
#X obj 380 320 s engineL_pb;
#X obj 450 320 s engineL_timbre;
#X obj 540 320 s engineL_pressure;
#X obj 650 320 s engineL_state;
#X obj 760 320 s engineL_pbg;
#X obj 60 350 print L/EVENTS;
#X obj 380 350 print L/UPDATES;
#X text 60 80 LOWER ZONE (master ch 1 • notes 2–16);
#X text 700 80 UPPER ZONE (master ch 16 • notes 1–15);
#X obj 700 110 loadbang;
#X msg 700 140 zone upper;
#X msg 800 140 normalize 1;
#X msg 900 140 pbmode 0;
#X msg 980 140 bendrange 48;
#X obj 700 180 s ctlU;
#X obj 700 220 r ctlU;
#X obj 700 250 mpe_poly;
#X obj 700 290 route note off;
#X obj 700 320 s engineU_events;
#X obj 880 320 s engineU_offs;
#X obj 1020 290 route pb timbre pressure state pb_global;
#X obj 1020 320 s engineU_pb;
#X obj 1090 320 s engineU_timbre;
#X obj 1180 320 s engineU_pressure;
#X obj 1290 320 s engineU_state;
#X obj 1400 320 s engineU_pbg;
#X obj 700 350 print U/EVENTS;
#X obj 1020 350 print U/UPDATES;
#X text 40 400 === Example "engines" (stub patches) that just print what they'd receive ===;
#X obj 60 430 r engineL_events;
#X obj 60 460 print ENGINE_L/notes;
#X obj 240 430 r engineL_offs;
#X obj 240 460 print ENGINE_L/offs;
#X obj 380 430 r engineL_pb;
#X obj 380 460 print ENGINE_L/pb;
#X obj 540 430 r engineL_timbre;
#X obj 540 460 print ENGINE_L/timbre;
#X obj 650 430 r engineL_pressure;
#X obj 650 460 print ENGINE_L/pressure;
#X obj 760 430 r engineL_state;
#X obj 760 460 print ENGINE_L/state;
#X obj 880 430 r engineL_pbg;
#X obj 880 460 print ENGINE_L/pb_global;
#X obj 60 520 r engineU_events;
#X obj 60 550 print ENGINE_U/notes;
#X obj 240 520 r engineU_offs;
#X obj 240 550 print ENGINE_U/offs;
#X obj 380 520 r engineU_pb;
#X obj 380 550 print ENGINE_U/pb;
#X obj 540 520 r engineU_timbre;
#X obj 540 550 print ENGINE_U/timbre;
#X obj 650 520 r engineU_pressure;
#X obj 650 550 print ENGINE_U/pressure;
#X obj 760 520 r engineU_state;
#X obj 760 550 print ENGINE_U/state;
#X obj 880 520 r engineU_pbg;
#X obj 880 550 print ENGINE_U/pb_global;
