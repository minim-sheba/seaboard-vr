#N canvas 236 86 1000 720 10;
#X obj 40 40 cnv 15 360 60 empty empty mpe_poly~help 20 12 0 14 -228856 -1 0;
#X text 50 45 mpe_poly — Polyphonic MPE-aware external (events + updates);
#X text 50 65 Left outlet: note/off  •  Right outlet: pb/timbre/pressure/state;
#X obj 60 140 loadbang;
#X msg 60 170 zone lower;
#X msg 160 170 normalize 1;
#X msg 270 170 pbmode 0;
#X msg 350 170 bendrange 48;
#X obj 60 220 s ctl;
#X obj 60 260 r ctl;
#X obj 60 290 mpe_poly;
#X obj 60 330 print EVENTS;
#X obj 260 330 print UPDATES;
#X text 450 130 === Test generators (simulate an MPE controller) ===;
#X obj 460 160 tgl 15 0 empty empty RUN 0 -6 0 10 -262144 -1 -1 0 1;
#X obj 460 190 metro 250;
#X obj 460 220 f 0;
#X obj 500 220 + 1;
#X obj 460 250 % 8;
#X obj 460 280 + 60;
#X msg 460 310 noteon $1 100 2;
#X msg 620 310 noteoff $1 0 2;
#X obj 720 160 tgl 15 0 empty empty PB 0 -6 0 10 -262144 -1 -1 0 1;
#X obj 720 190 metro 33;
#X obj 720 220 osc~ 0.2;
#X obj 720 250 *~ 8191;
#X obj 720 280 +~ 8192;
#X obj 720 310 snapshot~;
#X obj 720 340 int;
#X msg 720 370 pitchbend $1 2;
#X obj 840 190 hsl 128 15 0 127 0 0 empty empty CC74(timbre) -2 -6 0 10 -262144 -1 -1 0 1;
#X floatatom 840 220 5 0 0 0 - - -;
#X msg 840 250 cc 74 $1 2;
#X obj 60 360 route note off;
#X obj 60 390 unpack f f f f;
#X obj 260 360 route pb timbre pressure state pb_global;
#X obj 260 390 print PB;
#X obj 330 390 print TIMBRE;
#X obj 420 390 print PRESSURE;
#X obj 520 390 print STATE;
#X obj 620 390 print PB_GLOBAL;
