#N canvas 400 50 800 600 10;
#X declare -lib mpe_poly;
#X obj 60 60 notein;
#X obj 60 100 pack f f f;
#X obj 60 140 list prepend noteon;
#X obj 60 180 list trim;
#X obj 60 220 mpe_poly;
#X obj 60 260 print EVENTS;
#X obj 260 260 print UPDATES;
#X obj 200 60 bendin;
#X obj 200 100 pack f f;
#X obj 200 140 list prepend pitchbend;
#X obj 200 180 list trim;
#X connect 0 0 1 0;
#X connect 0 1 1 1;
#X connect 0 2 1 2;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 4 1 6 0;
#X connect 7 0 8 0;
#X connect 7 1 8 1;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 10 0 4 0;
