#N canvas 400 50 1600 1000 10;
#X declare -lib mpe_poly;
#X obj 40 40 cnv 15 400 60 empty empty mpe_poly~help 20 12 0 14 #dcdcdc #000000 0;
#X text 50 65 mpe_poly — Polyphonic MPE-aware external (events + updates);
#X text 50 85 Left outlet: note/off • Right outlet: pb/timbre/pressure/state;
#X obj 60 170 loadbang;
#X msg 60 200 zone lower;
#X msg 160 200 normalize 1;
#X msg 270 200 pbmode 0;
#X msg 350 200 bendrange 48;
#X obj 60 250 s ctl;
#X obj 60 290 r ctl;
#X obj 60 320 mpe_poly;
#X obj 60 360 print EVENTS;
#X obj 260 360 print UPDATES;
#X text 480 140 === Test generators (simulate an MPE controller) ===;
#X obj 480 190 tgl 15 0 empty empty RUN 0 -6 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 480 220 metro 250;
#X obj 480 250 f 0;
#X obj 520 250 + 1;
#X obj 480 280 % 8;
#X obj 480 310 + 60;
#X msg 480 340 noteon 0 100 2;
#X msg 640 340 noteoff 0 0 2;
#X obj 740 190 tgl 15 0 empty empty PB 0 -6 0 10 #fcfcfc #000000 #000000 0 1;
#X obj 740 220 metro 33;
#X obj 740 250 osc~ 0.2;
#X obj 740 280 *~ 8191;
#X obj 740 310 +~ 8192;
#X obj 740 340 snapshot~;
#X obj 740 370 int;
#X msg 740 400 pitchbend 0 2;
#X obj 860 190 hsl 128 15 0 127 0 0 empty empty CC74(timbre) -2 -6 0 10 #fcfcfc #000000 #000000 0 1;
#X floatatom 860 220 5 0 0 0 - - - 0;
#X msg 860 250 cc 74 0 2;
#X obj 60 390 route note off;
#X obj 60 420 unpack f f f f;
#X obj 260 390 route pb timbre pressure state pb_global;
#X obj 260 420 print PB;
#X obj 330 420 print TIMBRE;
#X obj 420 420 print PRESSURE;
#X obj 520 420 print STATE;
#X obj 620 420 print PB_GLOBAL;
